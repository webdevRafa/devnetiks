{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/contact",
      "destination": "/start",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/client/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/app/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/invoices/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
